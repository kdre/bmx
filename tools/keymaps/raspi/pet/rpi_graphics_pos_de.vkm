# BMC64 PET graphics keyboard mapping for a German PC keyboard
# The included base map is staged from rpi_grus_sym.vkm.

!INCLUDE gtk3_grus_pos.vkm

# Generated from C64 positional DE reference.
LeftBracket 8 1 16  # at
SemiColon 5 4 16  # colon
Comma 7 3 32  # comma
Comma 6 4 144  # semicolon
BackSlash 0 1 48  # numbersign
BackSlash 1 2 144  # apostrophe
Pound 0 1 48  # numbersign
Pound 1 2 144  # apostrophe
Equals 1 3 0  # sterling
Period 9 6 32  # period
Period 5 4 144  # colon
Dash 7 7 48  # plus
Dash 7 4 144  # question
SingleQuote 6 4 0  # semicolon
Slash 8 7 32  # minus
Slash 1 1 129  # underscore
Space 9 2 8  # space
Insert 1 3 0  # sterling
RightBracket 7 7 48  # plus
RightBracket 5 7 144  # asterisk
KP_BackSlash 9 3 48  # less
KP_BackSlash 8 4 144  # greater
0 8 6 32  # 0
0 9 7 144  # equal
1 6 6 0  # 1
2 7 6 0  # 2
3 6 7 32  # 3
3 0 1 144  # numbersign
4 4 6 0  # 4
5 5 6 0  # 5
6 4 7 0  # 6
7 2 6 32  # 7
7 3 7 144  # slash
8 3 6 0  # 8
9 2 7 0  # 9
a 4 0 0  # a
b 6 2 0  # b
c 6 1 0  # c
d 4 1 0  # d
e 2 1 0  # e
f 5 1 0  # f
g 4 2 0  # g
h 5 2 0  # h
i 3 3 0  # i
j 4 3 0  # j
k 5 3 0  # k
l 4 4 0  # l
m 6 3 0  # m
n 7 2 0  # n
o 2 4 0  # o
p 3 4 0  # p
q 2 0 0  # q
r 3 1 0  # r
s 5 0 0  # s
t 2 2 0  # t
u 2 3 0  # u
v 7 1 0  # v
w 3 0 0  # w
x 7 0 0  # x
y 6 0 0  # z
z 3 2 0  # y
