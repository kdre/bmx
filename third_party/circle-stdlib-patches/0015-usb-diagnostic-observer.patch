+#include <circle/usb/usbhid.h>
+#include <circle/usb/usbhostcontroller.h>
+#include <circle/logger.h>
+#include <circle/util.h>
+#include <assert.h>
+
+#define USBHIDDIAGNOSTIC_MAX_REPORT_DESCRIPTOR_SIZE	4096
+
+static const char FromUSBHIDDiagnostic[] = "usbhiddiag";
+
+CUSBHIDDiagnosticDevice::CUSBHIDDiagnosticDevice (CUSBFunction *pFunction)
+:	CUSBHIDDevice (pFunction)
+{
+}
+
+boolean CUSBHIDDiagnosticDevice::Configure (void)
+{
+	CUSBFunction TempFunction (this);
+	const TUSBHIDDescriptor *pHIDDesc =
+		(const TUSBHIDDescriptor *) TempFunction.GetDescriptor (DESCRIPTOR_HID);
+	if (   pHIDDesc == 0
+	    || pHIDDesc->bLength < sizeof *pHIDDesc
+	    || pHIDDesc->wReportDescriptorLength == 0
+	    || pHIDDesc->wReportDescriptorLength > USBHIDDIAGNOSTIC_MAX_REPORT_DESCRIPTOR_SIZE)
+	{
+		CLogger::Get ()->Write (FromUSBHIDDiagnostic, LogWarning,
+				       "Invalid HID report descriptor length");
+
+		return FALSE;
+	}
+
+	unsigned nReportDescriptorLength = pHIDDesc->wReportDescriptorLength;
+	DMA_BUFFER (u8, ReportDescriptor, nReportDescriptorLength);
+	if (GetHost ()->GetDescriptor (GetEndpoint0 (),
+				 pHIDDesc->bReportDescriptorType, DESCRIPTOR_INDEX_DEFAULT,
+				 ReportDescriptor, nReportDescriptorLength,
+				 REQUEST_IN | REQUEST_TO_INTERFACE, GetInterfaceNumber ())
+	    != (int) nReportDescriptorLength)
+	{
+		CLogger::Get ()->Write (FromUSBHIDDiagnostic, LogWarning,
+				       "Cannot get HID report descriptor");
+
+		return FALSE;
+	}
+
+	// Do not select a HID protocol or send output reports. The fallback only
+	// observes the interface's existing interrupt-IN stream.
+	if (!ConfigureHID (0, FALSE))
+	{
+		return FALSE;
+	}
+
+	return StartRequest ();
+}
+
+boolean CUSBHIDDiagnosticDevice::ShouldRestartRequest (void)
+{
+	const TUSBInterfaceDescriptor *pInterface = GetInterfaceDescriptor ();
+	assert (pInterface != 0);
+
+	// A request may still be pending when a diagnostic session ends. Recheck
+	// the observer after it completes so that request is never chained into a
+	// dormant reader.
+	return GetHost ()->WantDiagnosticHIDFallback (GetDevice (), *pInterface);
+}
+
+void CUSBHIDDiagnosticDevice::ReportHandler (const u8 *pReport, unsigned nReportSize)
+{
+	(void) pReport;
+	(void) nReportSize;
+
+	// The generic observer tap in CUSBHIDDevice has already copied the report.
+}
