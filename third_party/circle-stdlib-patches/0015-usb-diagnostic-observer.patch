+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+//
+#ifndef _circle_usb_usbdiagnosticobserver_h
+#define _circle_usb_usbdiagnosticobserver_h
+
+#include <circle/usb/usb.h>
+#include <circle/types.h>
+
+class CUSBDevice;
+
+struct TUSBDiagnosticDeviceInfo
+{
+	const CUSBDevice *pDevice;	// callback-only identity token
+	unsigned nHostController;	// 0-based host index (always 0 on Raspberry Pi 4)
+	unsigned nRootHubPort;		// 1-based xHCI root port ID
+	u32 nRouteString;		// xHCI route, first downstream port in low nibble
+	u8 ucAddress;			// xHCI slot ID on Raspberry Pi 4 and later
+	TUSBSpeed Speed;
+};
+
+enum TUSBDiagnosticDeviceEvent
+{
+	USBDeviceEventConnected,
+	USBDeviceEventEnumerationComplete,
+	USBDeviceEventEnumerationFailed,
+	USBDeviceEventConfigurationComplete,
+	USBDeviceEventConfigurationFailed,
+	USBDeviceEventRemoved
+};
+
+// The observer is optional and owned by the caller. Install or remove it only
+// from task level while no USB callback can be in progress. Descriptor and
+// product buffers are valid only until their callback returns. OnUSBHIDReport
+// may run at IRQ level and must not allocate, block or format output.
+class CUSBDiagnosticObserver
+{
+public:
+	virtual ~CUSBDiagnosticObserver (void) {}
+
+	virtual void OnUSBDeviceEvent (const TUSBDiagnosticDeviceInfo &Info,
+				       TUSBDiagnosticDeviceEvent Event) {}
+
+	// String descriptors are deliberately not reported. nResult is the
+	// received byte count, or a negative value when the request failed.
+	virtual void OnUSBDescriptor (const TUSBDiagnosticDeviceInfo &Info,
+				      u8 ucType, u8 ucIndex, u16 usIndex,
+				      const void *pBuffer, unsigned nRequested,
+				      int nResult) {}
+
+	// Product has already been decoded by Circle. It may be empty and must be
+	// copied by the observer if it is needed after this callback returns.
+	virtual void OnUSBProduct (const TUSBDiagnosticDeviceInfo &Info,
+				   const char *pProduct) {}
+
+	// Called only after all normal drivers rejected a HID interface. Returning
+	// TRUE enables a passive interrupt-IN diagnostic function for this interface.
+	virtual boolean WantHIDFallback (const TUSBDiagnosticDeviceInfo &Info,
+					 const TUSBInterfaceDescriptor &Interface)
+	{
+		return FALSE;
+	}
+
+	// pReport is owned by the HID driver and remains valid only for this call.
+	// This callback may execute at IRQ level.
+	virtual void OnUSBHIDReport (const TUSBDiagnosticDeviceInfo &Info,
+				     u8 ucInterface, u8 ucEndpoint,
+				     const u8 *pReport, unsigned nLength) {}
+};
+
+#endif
