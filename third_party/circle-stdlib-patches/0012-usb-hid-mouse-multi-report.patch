+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+//
+#include <circle/usb/usbmouseparser.h>
+#include <string.h>
+
+namespace
+{
+
+// HID 1.11, section 6.2.2
+enum
+{
+	HIDItemLong		= 0xFE,
+
+	HIDTypeMain		= 0,
+	HIDTypeGlobal		= 1,
+	HIDTypeLocal		= 2,
+
+	HIDMainInput		= 8,
+	HIDMainOutput		= 9,
+	HIDMainCollection	= 10,
+	HIDMainFeature		= 11,
+	HIDMainEndCollection	= 12,
+
+	HIDGlobalUsagePage	= 0,
+	HIDGlobalReportSize	= 7,
+	HIDGlobalReportID	= 8,
+	HIDGlobalReportCount	= 9,
+	HIDGlobalPush		= 10,
+	HIDGlobalPop		= 11,
+
+	HIDLocalUsage		= 0,
+	HIDLocalUsageMinimum	= 1,
+	HIDLocalUsageMaximum	= 2,
+	HIDLocalDelimiter	= 10,
+
+	HIDCollectionApplication = 1,
+
+	HIDInputConstant	= 1 << 0,
+	HIDInputVariable	= 1 << 1,
+	HIDInputRelative	= 1 << 2,
+
+	HIDUsagePageGenericDesktop = 0x01,
+	HIDUsagePageButton	= 0x09,
+
+	HIDUsageMouse		= 0x02,
+	HIDUsageX		= 0x30,
+	HIDUsageY		= 0x31,
+	HIDUsageWheel		= 0x38,
+
+	MaxDescriptorSize	= 4096,
+	MaxInputReportSize	= 4096,
+	MaxLocalUsages		= 64,
+	MaxCollectionDepth	= 16,
+	MaxGlobalStackDepth	= 8
+};
+
+struct TGlobalState
+{
+	u32 UsagePage;
+	u32 ReportSize;
+	u32 ReportCount;
+	u8 ReportID;
+};
+
+struct TLocalUsage
+{
+	u32 Value;
+	u8 Size;
+};
+
+struct TLocalState
+{
+	TLocalUsage Usage[MaxLocalUsages];
+	unsigned UsageCount;
+	boolean UsageOverflow;
+	TLocalUsage UsageMinimum;
+	boolean HasUsageMinimum;
+	unsigned DelimiterDepth;
+	unsigned DelimiterBranch;
+};
+
+struct TCollectionState
+{
+	boolean MouseApplication;
+};
+
+static void ResetLocalState (TLocalState *pLocal)
+{
+	memset (pLocal, 0, sizeof *pLocal);
+}
+
+static u32 CompleteUsage (const TLocalUsage &Usage, u32 nUsagePage)
+{
+	if (Usage.Size <= 2)
+	{
+		return (nUsagePage << 16) | (Usage.Value & 0xFFFF);
+	}
+
+	return Usage.Value;
+}
+
+static boolean AddLocalUsage (TLocalState *pLocal, u32 nValue, u8 uchSize)
+{
+	if (pLocal->DelimiterBranch > 1)
+	{
+		return TRUE;
+	}
+
+	if (pLocal->UsageCount >= MaxLocalUsages)
+	{
+		pLocal->UsageOverflow = TRUE;
+		return TRUE;
+	}
+
+	pLocal->Usage[pLocal->UsageCount].Value = nValue;
+	pLocal->Usage[pLocal->UsageCount].Size = uchSize;
+	pLocal->UsageCount++;
+
+	return TRUE;
+}
+
+static boolean AddUsageRange (TLocalState *pLocal, u32 nMaximum, u8 uchMaximumSize,
+			      u32 nUsagePage)
+{
+	if (!pLocal->HasUsageMinimum)
+	{
+		return FALSE;
+	}
+
+	u32 nMinimum = CompleteUsage (pLocal->UsageMinimum, nUsagePage);
+	TLocalUsage Maximum = {nMaximum, uchMaximumSize};
+	nMaximum = CompleteUsage (Maximum, nUsagePage);
+	pLocal->HasUsageMinimum = FALSE;
+
+	if (nMaximum < nMinimum)
+	{
+		return FALSE;
+	}
+
+	u32 nCount = nMaximum - nMinimum + 1;
+	if (nCount > MaxLocalUsages - pLocal->UsageCount)
+	{
+		pLocal->UsageOverflow = TRUE;
+		nCount = MaxLocalUsages - pLocal->UsageCount;
+	}
+
+	for (u32 i = 0; i < nCount; i++)
+	{
+		if (!AddLocalUsage (pLocal, nMinimum + i, 4))
+		{
+			return FALSE;
+		}
+	}
+
+	return TRUE;
+}
+
+static u32 GetLocalUsage (const TLocalState &Local, unsigned nIndex, u32 nUsagePage)
+{
+	if (Local.UsageCount == 0)
+	{
+		return 0;
+	}
+
+	if (nIndex >= Local.UsageCount)
+	{
+		nIndex = Local.UsageCount - 1;
+	}
+
+	return CompleteUsage (Local.Usage[nIndex], nUsagePage);
+}
+
+}
+
+CUSBMouseReportParser::CUSBMouseReportParser (void)
+:	m_pLayouts (0),
+	m_nLayoutCount (0),
+	m_nMaxInputReportSize (0),
+	m_nButtonCount (0),
+	m_nButtonState (0),
+	m_bHasWheel (FALSE),
+	m_bUsesReportIDs (FALSE)
+{
+}
+
+CUSBMouseReportParser::~CUSBMouseReportParser (void)
+{
+	Reset ();
+}
+
+void CUSBMouseReportParser::Reset (void)
+{
+	delete [] m_pLayouts;
+	m_pLayouts = 0;
+	m_nLayoutCount = 0;
+	m_nMaxInputReportSize = 0;
+	m_nButtonCount = 0;
+	m_nButtonState = 0;
+	m_bHasWheel = FALSE;
+	m_bUsesReportIDs = FALSE;
+}
+
+boolean CUSBMouseReportParser::Parse (const u8 *pDescriptor, unsigned nDescriptorSize)
+{
+	Reset ();
+
+	if (   pDescriptor == 0
+	    || nDescriptorSize == 0
+	    || nDescriptorSize > MaxDescriptorSize)
+	{
+		return FALSE;
+	}
+
+	u32 InputBits[MaxReportIDs];
+	u8 InputSeen[MaxReportIDs];
+	u8 MouseReportIDs[MaxReportIDs];
+	boolean bUsesReportIDs = FALSE;
+
+	if (!ParsePass (pDescriptor, nDescriptorSize, FALSE, InputBits, InputSeen,
+			MouseReportIDs, &bUsesReportIDs))
+	{
+		return FALSE;
+	}
+
+	unsigned nLayoutCount = 0;
+	for (unsigned nID = 0; nID < MaxReportIDs; nID++)
+	{
+		if (InputSeen[nID])
+		{
+			unsigned nByteSize = (InputBits[nID] + 7) / 8;
+			if (bUsesReportIDs)
+			{
+				nByteSize++;
+			}
+
+			if (   nByteSize == 0
+			    || nByteSize > MaxInputReportSize)
+			{
+				return FALSE;
+			}
+
+			if (nByteSize > m_nMaxInputReportSize)
+			{
+				m_nMaxInputReportSize = nByteSize;
+			}
+		}
+
+		if (MouseReportIDs[nID])
+		{
+			nLayoutCount++;
+		}
+	}
+
+	if (nLayoutCount == 0 || m_nMaxInputReportSize == 0)
+	{
+		Reset ();
+		return FALSE;
+	}
+
+	m_pLayouts = new TReportLayout[nLayoutCount];
+	if (m_pLayouts == 0)
+	{
+		Reset ();
+		return FALSE;
+	}
+	memset (m_pLayouts, 0, sizeof (TReportLayout) * nLayoutCount);
+	m_nLayoutCount = nLayoutCount;
+	m_bUsesReportIDs = bUsesReportIDs;
+
+	unsigned nLayout = 0;
+	for (unsigned nID = 0; nID < MaxReportIDs; nID++)
+	{
+		if (!MouseReportIDs[nID])
+		{
+			continue;
+		}
+
+		m_pLayouts[nLayout].ReportID = (u8) nID;
+		m_pLayouts[nLayout].ByteSize = (InputBits[nID] + 7) / 8
+						    + (bUsesReportIDs ? 1 : 0);
+		nLayout++;
+	}
+
+	u32 VerifyInputBits[MaxReportIDs];
+	u8 VerifyInputSeen[MaxReportIDs];
+	u8 VerifyMouseReportIDs[MaxReportIDs];
+	boolean bVerifyUsesReportIDs = FALSE;
+	if (!ParsePass (pDescriptor, nDescriptorSize, TRUE, VerifyInputBits, VerifyInputSeen,
+			VerifyMouseReportIDs, &bVerifyUsesReportIDs))
+	{
+		Reset ();
+		return FALSE;
+	}
+
+	if (   bVerifyUsesReportIDs != m_bUsesReportIDs
+	    || memcmp (InputBits, VerifyInputBits, sizeof InputBits) != 0
+	    || memcmp (InputSeen, VerifyInputSeen, sizeof InputSeen) != 0
+	    || memcmp (MouseReportIDs, VerifyMouseReportIDs, sizeof MouseReportIDs) != 0)
+	{
+		Reset ();
+		return FALSE;
+	}
+
+	boolean bHasX = FALSE;
+	boolean bHasY = FALSE;
+	for (unsigned i = 0; i < m_nLayoutCount; i++)
+	{
+		TReportLayout *pLayout = &m_pLayouts[i];
+		for (unsigned nButton = 0; nButton < MaxButtons; nButton++)
+		{
+			if (pLayout->Button[nButton].Present && m_nButtonCount < nButton + 1)
+			{
+				m_nButtonCount = nButton + 1;
+			}
+		}
+
+		bHasX |= pLayout->X.Present && pLayout->X.Relative;
+		bHasY |= pLayout->Y.Present && pLayout->Y.Relative;
+		m_bHasWheel |= pLayout->Wheel.Present && pLayout->Wheel.Relative;
+	}
+
+	if (!bHasX || !bHasY)
+	{
+		Reset ();
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+boolean CUSBMouseReportParser::ParsePass (const u8 *pDescriptor, unsigned nDescriptorSize,
+					 boolean bStoreLayouts, u32 *pInputBits,
+					 u8 *pInputSeen, u8 *pMouseReportIDs,
+					 boolean *pUsesReportIDs)
+{
+	memset (pInputBits, 0, sizeof (u32) * MaxReportIDs);
+	memset (pInputSeen, 0, sizeof (u8) * MaxReportIDs);
+	memset (pMouseReportIDs, 0, sizeof (u8) * MaxReportIDs);
+	*pUsesReportIDs = FALSE;
+
+	TGlobalState Global;
+	memset (&Global, 0, sizeof Global);
+	TGlobalState GlobalStack[MaxGlobalStackDepth];
+	unsigned nGlobalStackDepth = 0;
+
+	TLocalState Local;
+	ResetLocalState (&Local);
+
+	TCollectionState Collection[MaxCollectionDepth];
+	unsigned nCollectionDepth = 0;
+	boolean bNumberedInputSeen = FALSE;
+	boolean bUnnumberedInputSeen = FALSE;
+
+	while (nDescriptorSize > 0)
+	{
+		u8 uchPrefix = *pDescriptor++;
+		nDescriptorSize--;
+
+		if (uchPrefix == HIDItemLong)
+		{
+			if (nDescriptorSize < 2)
+			{
+				return FALSE;
+			}
+
+			unsigned nLongSize = pDescriptor[0];
+			pDescriptor += 2;       // data size and long item tag
+			nDescriptorSize -= 2;
+			if (nLongSize > nDescriptorSize)
+			{
+				return FALSE;
+			}
+
+			pDescriptor += nLongSize;
+			nDescriptorSize -= nLongSize;
+			continue;
+		}
+
+		unsigned nSizeCode = uchPrefix & 0x03;
+		unsigned nItemSize = nSizeCode == 3 ? 4 : nSizeCode;
+		if (nItemSize > nDescriptorSize)
+		{
+			return FALSE;
+		}
+
+		u32 nValue = 0;
+		for (unsigned i = 0; i < nItemSize; i++)
+		{
+			nValue |= (u32) pDescriptor[i] << (i * 8);
+		}
+		pDescriptor += nItemSize;
+		nDescriptorSize -= nItemSize;
+
+		unsigned nType = (uchPrefix >> 2) & 0x03;
+		unsigned nTag = (uchPrefix >> 4) & 0x0F;
+
+		if (nType == HIDTypeGlobal)
+		{
+			switch (nTag)
+			{
+			case HIDGlobalUsagePage:
+				Global.UsagePage = nValue;
+				break;
+
+			case HIDGlobalReportSize:
+				if (nValue > 256)
+				{
+					return FALSE;
+				}
+				Global.ReportSize = nValue;
+				break;
+
+			case HIDGlobalReportID:
+				if (nValue == 0 || nValue >= MaxReportIDs)
+				{
+					return FALSE;
+				}
+				Global.ReportID = (u8) nValue;
+				break;
+
+			case HIDGlobalReportCount:
+				if (nValue > MaxInputReportSize * 8)
+				{
+					return FALSE;
+				}
+				Global.ReportCount = nValue;
+				break;
+
+			case HIDGlobalPush:
+				if (nGlobalStackDepth >= MaxGlobalStackDepth)
+				{
+					return FALSE;
+				}
+				GlobalStack[nGlobalStackDepth++] = Global;
+				break;
+
+			case HIDGlobalPop:
+				if (nGlobalStackDepth == 0)
+				{
+					return FALSE;
+				}
+				Global = GlobalStack[--nGlobalStackDepth];
+				break;
+
+			case 1:     // Logical Minimum
+			case 2:     // Logical Maximum
+			case 3:     // Physical Minimum
+			case 4:     // Physical Maximum
+			case 5:     // Unit Exponent
+			case 6:     // Unit
+				break;
+
+			default:
+				return FALSE;
+			}
+
+			continue;
+		}
+
+		if (nType == HIDTypeLocal)
+		{
+			switch (nTag)
+			{
+			case HIDLocalUsage:
+				if (!AddLocalUsage (&Local, nValue, (u8) nItemSize))
+				{
+					return FALSE;
+				}
+				break;
+
+			case HIDLocalUsageMinimum:
+				Local.UsageMinimum.Value = nValue;
+				Local.UsageMinimum.Size = (u8) nItemSize;
+				Local.HasUsageMinimum = TRUE;
+				break;
+
+			case HIDLocalUsageMaximum:
+				if (!AddUsageRange (&Local, nValue, (u8) nItemSize, Global.UsagePage))
+				{
+					return FALSE;
+				}
+				break;
+
+			case HIDLocalDelimiter:
+				if (nValue != 0)
+				{
+					if (Local.DelimiterDepth != 0)
+					{
+						return FALSE;
+					}
+					Local.DelimiterDepth++;
+					Local.DelimiterBranch++;
+				}
+				else
+				{
+					if (Local.DelimiterDepth == 0)
+					{
+						return FALSE;
+					}
+					Local.DelimiterDepth--;
+				}
+				break;
+
+			default:
+				break;
+			}
+
+			continue;
+		}
+
+		if (nType != HIDTypeMain)
+		{
+			continue;
+		}
+
+		boolean bMouseApplication = nCollectionDepth > 0
+					    ? Collection[nCollectionDepth-1].MouseApplication
+					    : FALSE;
+
+		switch (nTag)
+		{
+		case HIDMainCollection:
+			if (   nCollectionDepth >= MaxCollectionDepth
+			    || Local.DelimiterDepth != 0)
+			{
+				return FALSE;
+			}
+
+			if (nValue == HIDCollectionApplication)
+			{
+				u32 nUsage = GetLocalUsage (Local, 0, Global.UsagePage);
+				bMouseApplication = nUsage
+					== ((u32) HIDUsagePageGenericDesktop << 16 | HIDUsageMouse);
+			}
+
+			Collection[nCollectionDepth++].MouseApplication = bMouseApplication;
+			break;
+
+		case HIDMainEndCollection:
+			if (nCollectionDepth == 0)
+			{
+				return FALSE;
+			}
+			nCollectionDepth--;
+			break;
+
+		case HIDMainInput:
+		{
+			u8 uchReportID = Global.ReportID;
+			if (uchReportID != 0)
+			{
+				bNumberedInputSeen = TRUE;
+			}
+			else
+			{
+				bUnnumberedInputSeen = TRUE;
+			}
+			if (bNumberedInputSeen && bUnnumberedInputSeen)
+			{
+				return FALSE;
+			}
+
+			u64 nFieldBits = (u64) Global.ReportSize * Global.ReportCount;
+			if (   nFieldBits > MaxInputReportSize * 8
+			    || pInputBits[uchReportID] > MaxInputReportSize * 8 - nFieldBits)
+			{
+				return FALSE;
+			}
+
+			pInputSeen[uchReportID] = 1;
+			boolean bVariableData = !(nValue & HIDInputConstant)
+						&& (nValue & HIDInputVariable);
+			if (bMouseApplication && bVariableData)
+			{
+				if (Local.UsageOverflow)
+				{
+					return FALSE;
+				}
+
+				unsigned nPrefixBits = uchReportID != 0 ? 8 : 0;
+				for (u32 i = 0; i < Global.ReportCount; i++)
+				{
+					u32 nUsage = GetLocalUsage (Local, i, Global.UsagePage);
+					u32 nUsagePage = nUsage >> 16;
+					u32 nUsageID = nUsage & 0xFFFF;
+					boolean bSupported = FALSE;
+					if (   nUsagePage == HIDUsagePageButton
+					    && nUsageID >= 1 && nUsageID <= MaxButtons)
+					{
+						bSupported = TRUE;
+					}
+					else if (   nUsagePage == HIDUsagePageGenericDesktop
+						 && (   nUsageID == HIDUsageX
+						     || nUsageID == HIDUsageY
+						     || nUsageID == HIDUsageWheel))
+					{
+						bSupported = TRUE;
+					}
+
+					if (!bSupported)
+					{
+						continue;
+					}
+
+					if (Global.ReportSize == 0 || Global.ReportSize > 32)
+					{
+						return FALSE;
+					}
+
+					pMouseReportIDs[uchReportID] = 1;
+					if (!bStoreLayouts)
+					{
+						continue;
+					}
+
+					TReportLayout *pLayout = FindLayout (uchReportID);
+					if (pLayout == 0)
+					{
+						return FALSE;
+					}
+
+					TReportItem *pItem = 0;
+					if (nUsagePage == HIDUsagePageButton)
+					{
+						pItem = &pLayout->Button[nUsageID - 1];
+					}
+					else if (nUsageID == HIDUsageX)
+					{
+						pItem = &pLayout->X;
+					}
+					else if (nUsageID == HIDUsageY)
+					{
+						pItem = &pLayout->Y;
+					}
+					else if (nUsageID == HIDUsageWheel)
+					{
+						pItem = &pLayout->Wheel;
+					}
+
+					if (pItem != 0 && !pItem->Present)
+					{
+						pItem->BitOffset = pInputBits[uchReportID] + nPrefixBits
+								 + i * Global.ReportSize;
+						pItem->BitSize = Global.ReportSize;
+						pItem->Present = TRUE;
+						pItem->Relative = (nValue & HIDInputRelative) != 0;
+					}
+				}
+			}
+
+			pInputBits[uchReportID] += (u32) nFieldBits;
+			break;
+		}
+
+		case HIDMainOutput:
+		case HIDMainFeature:
+			break;
+
+		default:
+			break;
+		}
+
+		ResetLocalState (&Local);
+	}
+
+	if (   nCollectionDepth != 0
+	    || nGlobalStackDepth != 0
+	    || Local.DelimiterDepth != 0)
+	{
+		return FALSE;
+	}
+
+	*pUsesReportIDs = bNumberedInputSeen;
+	return TRUE;
+}
+
+CUSBMouseReportParser::TReportLayout *CUSBMouseReportParser::FindLayout (u8 uchReportID)
+{
+	for (unsigned i = 0; i < m_nLayoutCount; i++)
+	{
+		if (m_pLayouts[i].ReportID == uchReportID)
+		{
+			return &m_pLayouts[i];
+		}
+	}
+
+	return 0;
+}
+
+const CUSBMouseReportParser::TReportLayout *CUSBMouseReportParser::FindLayout (u8 uchReportID) const
+{
+	for (unsigned i = 0; i < m_nLayoutCount; i++)
+	{
+		if (m_pLayouts[i].ReportID == uchReportID)
+		{
+			return &m_pLayouts[i];
+		}
+	}
+
+	return 0;
+}
+
+boolean CUSBMouseReportParser::Decode (const u8 *pReport, unsigned nReportSize,
+				      TUSBMouseReportData *pData)
+{
+	if (pReport == 0 || pData == 0 || nReportSize == 0)
+	{
+		return FALSE;
+	}
+
+	u8 uchReportID = m_bUsesReportIDs ? pReport[0] : 0;
+	const TReportLayout *pLayout = FindLayout (uchReportID);
+	if (pLayout == 0 || nReportSize != pLayout->ByteSize)
+	{
+		return FALSE;
+	}
+
+	pData->X = 0;
+	pData->Y = 0;
+	pData->Wheel = 0;
+
+	for (unsigned nButton = 0; nButton < MaxButtons; nButton++)
+	{
+		const TReportItem &Item = pLayout->Button[nButton];
+		if (!Item.Present)
+		{
+			continue;
+		}
+
+		unsigned nMask = 1 << nButton;
+		if (ExtractUnsigned (pReport, Item.BitOffset, Item.BitSize) != 0)
+		{
+			m_nButtonState |= nMask;
+		}
+		else
+		{
+			m_nButtonState &= ~nMask;
+		}
+	}
+
+	if (pLayout->X.Present && pLayout->X.Relative)
+	{
+		pData->X = ExtractSigned (pReport, pLayout->X.BitOffset, pLayout->X.BitSize);
+	}
+	if (pLayout->Y.Present && pLayout->Y.Relative)
+	{
+		pData->Y = ExtractSigned (pReport, pLayout->Y.BitOffset, pLayout->Y.BitSize);
+	}
+	if (pLayout->Wheel.Present && pLayout->Wheel.Relative)
+	{
+		pData->Wheel = ExtractSigned (pReport, pLayout->Wheel.BitOffset,
+					      pLayout->Wheel.BitSize);
+	}
+
+	pData->Buttons = m_nButtonState;
+	return TRUE;
+}
+
+u32 CUSBMouseReportParser::ExtractUnsigned (const u8 *pBuffer, unsigned nBitOffset,
+					    unsigned nBitSize)
+{
+	if (nBitSize == 0 || nBitSize > 32)
+	{
+		return 0;
+	}
+
+	u32 nResult = 0;
+	for (unsigned i = 0; i < nBitSize; i++)
+	{
+		unsigned nSourceBit = nBitOffset + i;
+		if (pBuffer[nSourceBit / 8] & (1 << (nSourceBit % 8)))
+		{
+			nResult |= (u32) 1 << i;
+		}
+	}
+
+	return nResult;
+}
+
+s32 CUSBMouseReportParser::ExtractSigned (const u8 *pBuffer, unsigned nBitOffset,
+					 unsigned nBitSize)
+{
+	u32 nResult = ExtractUnsigned (pBuffer, nBitOffset, nBitSize);
+	if (nBitSize == 0 || nBitSize >= 32)
+	{
+		return (s32) nResult;
+	}
+
+	u32 nSign = (u32) 1 << (nBitSize - 1);
+	if (nResult & nSign)
+	{
+		nResult |= ~((nSign << 1) - 1);
+	}
+
+	return (s32) nResult;
+}
+
+unsigned CUSBMouseReportParser::GetMaxInputReportSize (void) const
+{
+	return m_nMaxInputReportSize;
+}
+
+unsigned CUSBMouseReportParser::GetButtonCount (void) const
+{
+	return m_nButtonCount;
+}
+
+boolean CUSBMouseReportParser::HasWheel (void) const
+{
+	return m_bHasWheel;
+}
+
+boolean CUSBMouseReportParser::UsesReportIDs (void) const
+{
+	return m_bUsesReportIDs;
+}
