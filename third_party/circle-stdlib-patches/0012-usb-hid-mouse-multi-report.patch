+#define _circle_usb_usbmouseparser_h
+
+#include <circle/types.h>
+
+struct TUSBMouseReportData
+{
+	unsigned Buttons;
+	s32 X;
+	s32 Y;
+	s32 Wheel;
+};
+
+class CUSBMouseReportParser
+{
+public:
+	CUSBMouseReportParser (void);
+	~CUSBMouseReportParser (void);
+
+	boolean Parse (const u8 *pDescriptor, unsigned nDescriptorSize);
+
+	// Returns FALSE for unknown, non-mouse or malformed input reports.
+	boolean Decode (const u8 *pReport, unsigned nReportSize, TUSBMouseReportData *pData);
+
+	unsigned GetMaxInputReportSize (void) const;
+	unsigned GetButtonCount (void) const;
+	boolean HasWheel (void) const;
+	boolean UsesReportIDs (void) const;
+
+private:
+	static const unsigned MaxButtons = 5;
+	static const unsigned MaxReportIDs = 256;
+
+	struct TReportItem
+	{
+		unsigned BitOffset;
+		unsigned BitSize;
+		boolean Present;
+		boolean Relative;
+	};
+
+	struct TReportLayout
+	{
+		u8 ReportID;
+		unsigned ByteSize;
+		TReportItem Button[MaxButtons];
+		TReportItem X;
+		TReportItem Y;
+		TReportItem Wheel;
+	};
+
+	boolean ParsePass (const u8 *pDescriptor, unsigned nDescriptorSize,
+			   boolean bStoreLayouts, u32 *pInputBits, u8 *pInputSeen,
+			   u8 *pMouseReportIDs, boolean *pUsesReportIDs);
+
+	TReportLayout *FindLayout (u8 uchReportID);
+	const TReportLayout *FindLayout (u8 uchReportID) const;
+
+	static u32 ExtractUnsigned (const u8 *pBuffer, unsigned nBitOffset,
+				    unsigned nBitSize);
+	static s32 ExtractSigned (const u8 *pBuffer, unsigned nBitOffset,
+				 unsigned nBitSize);
+
+	void Reset (void);
+
+private:
+	TReportLayout *m_pLayouts;
+	unsigned m_nLayoutCount;
+	unsigned m_nMaxInputReportSize;
+	unsigned m_nButtonCount;
+	unsigned m_nButtonState;
+	boolean m_bHasWheel;
+	boolean m_bUsesReportIDs;
+
+private:
+	CUSBMouseReportParser (const CUSBMouseReportParser &rParser);
+	CUSBMouseReportParser &operator= (const CUSBMouseReportParser &rParser);
+};
+
+#endif
