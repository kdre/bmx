+int CBcm54213Device::bcm_phy_read_shadow(u16 shadow)
+{
+	mdio_write(MII_BCM54XX_SHD, MII_BCM54XX_SHD_VAL(shadow));
+
+	int value = mdio_read(MII_BCM54XX_SHD);
+	return value < 0 ? value : MII_BCM54XX_SHD_DATA(value);
+}
+
+void CBcm54213Device::bcm_phy_write_shadow(u16 shadow, u16 value)
+{
+	mdio_write(MII_BCM54XX_SHD,
+		     MII_BCM54XX_SHD_WRITE
+		   | MII_BCM54XX_SHD_VAL(shadow)
+		   | MII_BCM54XX_SHD_DATA(value));
+}
+
+int CBcm54213Device::phy_disable_tx_clock_delay(void)
+{
+	int clkctl = bcm_phy_read_shadow(BCM54810_SHD_CLK_CTL);
+	if (clkctl < 0)
+		return clkctl;
+
+	CLogger::Get()->Write(FromBcm54213, LogNotice,
+			      "RGMII RXID PHY %u CLK_CTL before: 0x%03X",
+			      m_phy_id, clkctl);
+
+	// The firmware-provided RX-delay state differs between Pi 4B and Pi 400,
+	// and both are known to work, so preserve it.  Only remove a PHY TX delay
+	// that would duplicate the TX delay enabled in the GENET MAC.
+	if (!(clkctl & BCM54810_SHD_CLK_CTL_GTXCLK_EN))
+		return 0;
+
+	bcm_phy_write_shadow(BCM54810_SHD_CLK_CTL,
+			     clkctl & ~BCM54810_SHD_CLK_CTL_GTXCLK_EN);
+
+	clkctl = bcm_phy_read_shadow(BCM54810_SHD_CLK_CTL);
+	if (clkctl < 0)
+		return clkctl;
+
+	CLogger::Get()->Write(FromBcm54213, LogNotice,
+			      "RGMII RXID PHY %u CLK_CTL after: 0x%03X",
+			      m_phy_id, clkctl);
+
+	if (clkctl & BCM54810_SHD_CLK_CTL_GTXCLK_EN)
+	{
+		CLogger::Get()->Write(FromBcm54213, LogError,
+				      "Failed to disable RGMII PHY TX clock delay");
+		return -1;
+	}
+
+	return 0;
+}
