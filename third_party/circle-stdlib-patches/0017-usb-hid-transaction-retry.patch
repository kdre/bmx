+void CXHCIUSBDevice::RecoverEndpoints (void)
+{
+	for (unsigned i = 0; i < XHCI_MAX_ENDPOINTS; i++)
+	{
+		if (m_pEndpoint[i] != 0)
+		{
+			m_pEndpoint[i]->RecoverFromHalted ();
+		}
+	}
+}
