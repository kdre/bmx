+void CXHCIEndpoint::RecoverFromHalted (void)
+{
+	m_SpinLock.Acquire ();
+	boolean bRecoveryPending = m_bRecoveryPending;
+	m_SpinLock.Release ();
+	if (!bRecoveryPending)
+	{
+		return;
+	}
+
+	boolean bSuccess = ResetFromHalted ();
+
+	m_SpinLock.Acquire ();
+	CUSBRequest *pURB0 = m_pURB[0];
+	CUSBRequest *pURB1 = m_pURB[1];
+	m_pURB[0] = 0;
+	m_pURB[1] = 0;
+	m_bRecoveryPending = FALSE;
+	m_SpinLock.Release ();
+
+	if (bSuccess)
+	{
+		CLogger::Get ()->Write (From, LogNotice,
+				      "Recovered slot %u endpoint %u (addr %02X)",
+				      (unsigned) m_pDevice->GetSlotID (),
+				      (unsigned) m_uchEndpointID,
+				      (unsigned) m_uchEndpointAddress);
+	}
+	else
+	{
+		CLogger::Get ()->Write (From, LogWarning,
+				      "Recovery failed on slot %u endpoint %u (addr %02X)",
+				      (unsigned) m_pDevice->GetSlotID (),
+				      (unsigned) m_uchEndpointID,
+				      (unsigned) m_uchEndpointAddress);
+	}
+
+	CUSBRequest *pURBs[] = {pURB0, pURB1};
+	for (unsigned i = 0; i < sizeof pURBs / sizeof pURBs[0]; i++)
+	{
+		CUSBRequest *pURB = pURBs[i];
+		if (pURB == 0)
+		{
+			continue;
+		}
+
+		if (bSuccess && TransferAsync (pURB, USB_TIMEOUT_NONE))
+		{
+			continue;
+		}
+
+		pURB->SetStatus (0);
+		pURB->SetUSBError (USBErrorUnknown);
+		pURB->CallCompletionRoutine ();
+	}
+}
