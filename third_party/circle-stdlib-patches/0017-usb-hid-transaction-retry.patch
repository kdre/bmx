+void CXHCISlotManager::RecoverEndpoints (void)
+{
+	for (unsigned nSlotIndex = 0; nSlotIndex < XHCI_CONFIG_MAX_SLOTS; nSlotIndex++)
+	{
+		if (m_pUSBDevice[nSlotIndex] != 0)
+		{
+			m_pUSBDevice[nSlotIndex]->RecoverEndpoints ();
+		}
+	}
+}
