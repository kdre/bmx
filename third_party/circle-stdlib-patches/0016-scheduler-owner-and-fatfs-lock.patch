diff --git a/libs/circle/addon/fatfs/ffsync.h b/libs/circle/addon/fatfs/ffsync.h
new file mode 100644
index 0000000..2784892
--- /dev/null
+++ b/libs/circle/addon/fatfs/ffsync.h
@@ -0,0 +1,98 @@
+#ifndef _circle_addon_fatfs_ffsync_h
+#define _circle_addon_fatfs_ffsync_h
+
+#include <circle/multicore.h>
+#include <circle/sched/scheduler.h>
+#include <circle/types.h>
+#include <assert.h>
+
+// A FatFs lock may be shared by the scheduler core and a non-scheduler core.
+// The scheduler core must yield while contended so the lock holder's I/O can
+// continue; a non-scheduler core must never enter Circle's scheduler.
+class CFatFsLock
+{
+public:
+	CFatFsLock (void)
+	:	m_nOwner (0),
+		m_nDepth (0)
+	{
+	}
+
+	void Acquire (void)
+	{
+		const uintptr nOwner = CurrentOwner ();
+		if (__atomic_load_n (&m_nOwner, __ATOMIC_ACQUIRE) == nOwner)
+		{
+			m_nDepth++;
+			return;
+		}
+
+		for (;;)
+		{
+			uintptr nExpected = 0;
+			if (__atomic_compare_exchange_n (&m_nOwner, &nExpected, nOwner,
+						 FALSE, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+			{
+				m_nDepth = 1;
+				return;
+			}
+
+			if (CScheduler::IsActive () && CScheduler::IsOwnerCore ())
+			{
+				CScheduler::Get ()->Yield ();
+			}
+			else
+			{
+				asm volatile ("yield");
+			}
+		}
+	}
+
+	void Release (void)
+	{
+		assert (__atomic_load_n (&m_nOwner, __ATOMIC_RELAXED) == CurrentOwner ());
+		assert (m_nDepth > 0);
+		if (--m_nDepth == 0)
+		{
+			__atomic_store_n (&m_nOwner, 0, __ATOMIC_RELEASE);
+		}
+	}
+
+private:
+	static uintptr CurrentOwner (void)
+	{
+		if (CScheduler::IsActive () && CScheduler::IsOwnerCore ())
+		{
+			return reinterpret_cast<uintptr> (CScheduler::Get ()->GetCurrentTask ());
+		}
+#ifdef ARM_ALLOW_MULTI_CORE
+		return static_cast<uintptr> (CMultiCoreSupport::ThisCore () + 1U);
+#else
+		return 1U;
+#endif
+	}
+
+private:
+	volatile uintptr m_nOwner;
+	unsigned m_nDepth;
+};
+
+class CFatFsLockGuard
+{
+public:
+	explicit CFatFsLockGuard (CFatFsLock &Lock)
+	:	m_Lock (Lock)
+	{
+		m_Lock.Acquire ();
+	}
+
+	~CFatFsLockGuard (void)
+	{
+		m_Lock.Release ();
+	}
+
+private:
+	CFatFsLock &m_Lock;
+};
+
+#endif
