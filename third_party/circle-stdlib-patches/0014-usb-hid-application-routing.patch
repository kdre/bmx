+#ifndef _circle_usb_usbhidapplication_h
+#define _circle_usb_usbhidapplication_h
+
+#include <circle/types.h>
+
+enum TUSBHIDApplicationMask
+{
+	USBHIDApplicationNone		= 0,
+	USBHIDApplicationMouse		= 1 << 0,
+	USBHIDApplicationJoystick	= 1 << 1,
+	USBHIDApplicationGamePad	= 1 << 2,
+	USBHIDApplicationTouchScreen	= 1 << 3,
+	USBHIDApplicationTouchPad	= 1 << 4,
+	USBHIDApplicationPen		= 1 << 5,
+	USBHIDApplicationKeyboard	= 1 << 6,
+	USBHIDApplicationAuxiliary	= 1 << 7,
+	USBHIDApplicationOther		= 1 << 8
+};
+
+enum TUSBHIDDeviceType
+{
+	USBHIDDeviceUnsupported,
+	USBHIDDeviceMouse,
+	USBHIDDeviceGamePad,
+	USBHIDDeviceTouchScreen,
+	USBHIDDeviceComposite
+};
+
+class CUSBHIDApplicationParser
+{
+public:
+	CUSBHIDApplicationParser (void);
+
+	boolean Parse (const u8 *pDescriptor, unsigned nDescriptorSize);
+
+	TUSBHIDDeviceType GetDeviceType (void) const;
+	unsigned GetApplicationMask (void) const;
+	unsigned GetInputApplicationCount (void) const;
+	boolean HasUnscopedInput (void) const;
+
+private:
+	static const unsigned MaxApplications = 16;
+
+	struct TApplication
+	{
+		u32 Usage;
+		boolean HasDataInput;
+	};
+
+	void Reset (void);
+	void Classify (void);
+	static unsigned ClassifyUsage (u32 nUsage);
+
+private:
+	TApplication m_Application[MaxApplications];
+	unsigned m_nApplicationCount;
+	unsigned m_nInputApplicationCount;
+	unsigned m_nApplicationMask;
+	TUSBHIDDeviceType m_DeviceType;
+	boolean m_bUnscopedInput;
+};
+
+#endif
