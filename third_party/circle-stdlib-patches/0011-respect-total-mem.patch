+boolean CMachineInfo::GetDTBHighMemSize (size_t *pSize) const
+{
+	assert (pSize != 0);
+	*pSize = 0;
+
+	if (m_pDTB == 0)
+	{
+		return FALSE;
+	}
+
+	const TDeviceTreeNode *pRoot = m_pDTB->FindNode ("/");
+	const TDeviceTreeNode *pMemory = m_pDTB->FindNode ("/memory@0");
+	if (pMemory == 0)
+	{
+		pMemory = m_pDTB->FindNode ("/memory");
+	}
+
+	if (pRoot == 0 || pMemory == 0)
+	{
+		return FALSE;
+	}
+
+	const TDeviceTreeProperty *pAddressCells =
+		m_pDTB->FindProperty (pRoot, "#address-cells");
+	const TDeviceTreeProperty *pSizeCells =
+		m_pDTB->FindProperty (pRoot, "#size-cells");
+	const TDeviceTreeProperty *pReg = m_pDTB->FindProperty (pMemory, "reg");
+	if (pAddressCells == 0 || pSizeCells == 0 || pReg == 0)
+	{
+		return FALSE;
+	}
+
+	unsigned nAddressCells = m_pDTB->GetPropertyValueWord (pAddressCells, 0);
+	unsigned nSizeCells = m_pDTB->GetPropertyValueWord (pSizeCells, 0);
+	if (   nAddressCells == 0 || nAddressCells > 2
+	    || nSizeCells == 0 || nSizeCells > 2)
+	{
+		return FALSE;
+	}
+
+	unsigned nEntryCells = nAddressCells + nSizeCells;
+	size_t nRegLength = m_pDTB->GetPropertyValueLength (pReg);
+	if (   nRegLength == 0
+	    || nRegLength % (nEntryCells * sizeof (u32)) != 0)
+	{
+		return FALSE;
+	}
+
+	unsigned nRegCells = nRegLength / sizeof (u32);
+	const u64 nHighMemStart = MEM_HIGHMEM_START;
+	const u64 nHighMemEnd = (u64) MEM_HIGHMEM_END + 1;
+
+	for (unsigned i = 0; i < nRegCells; i += nEntryCells)
+	{
+		u64 nAddress = 0;
+		for (unsigned j = 0; j < nAddressCells; j++)
+		{
+			nAddress = nAddress << 32
+				 | m_pDTB->GetPropertyValueWord (pReg, i+j);
+		}
+
+		u64 nSize = 0;
+		for (unsigned j = 0; j < nSizeCells; j++)
+		{
+			nSize = nSize << 32
+			      | m_pDTB->GetPropertyValueWord (pReg, i+nAddressCells+j);
+		}
+
+		u64 nRangeEnd = nAddress + nSize;
+		if (nRangeEnd < nAddress)
+		{
+			return FALSE;
+		}
+
+		if (nAddress <= nHighMemStart && nRangeEnd > nHighMemStart)
+		{
+			if (nRangeEnd > nHighMemEnd)
+			{
+				nRangeEnd = nHighMemEnd;
+			}
+
+			*pSize = (size_t) (nRangeEnd - nHighMemStart);
+			return TRUE;
+		}
+	}
+
+	// A valid memory map without a range above 1 GB disables high memory.
+	return TRUE;
+}
