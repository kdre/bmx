+boolean CUSBStandardHub::DebouncePort (unsigned nPortIndex)
+{
+	assert (nPortIndex < m_nPorts);
+	assert (m_pStatus[nPortIndex] != 0);
+
+	CUSBHostController *pHost = GetHost ();
+	assert (pHost != 0);
+
+	CUSBEndpoint *pEndpoint0 = GetEndpoint0 ();
+	assert (pEndpoint0 != 0);
+
+	u16 usConnection = 0xFFFF;
+	unsigned nStableMs = 0;
+
+	for (unsigned nTotalMs = 0; nTotalMs <= PortDebounceTimeoutMs;
+	     nTotalMs += PortDebounceStepMs)
+	{
+		if (pHost->ControlMessage (pEndpoint0,
+			REQUEST_IN | REQUEST_CLASS | REQUEST_TO_OTHER,
+			GET_STATUS, 0, nPortIndex+1, m_pStatus[nPortIndex], 4) != 4)
+		{
+			CLogger::Get ()->Write (FromHub, LogWarning,
+					      "Cannot debounce port %u", nPortIndex+1);
+			return FALSE;
+		}
+
+		u16 usChangeStatus = m_pStatus[nPortIndex]->wChangeStatus;
+		u16 usCurrentConnection =
+			m_pStatus[nPortIndex]->wPortStatus & PORT_CONNECTION__MASK;
+
+		if (   !(usChangeStatus & C_PORT_CONNECTION__MASK)
+		    && usCurrentConnection == usConnection)
+		{
+			nStableMs += PortDebounceStepMs;
+			if (nStableMs >= PortDebounceStableMs)
+			{
+				return TRUE;
+			}
+		}
+		else
+		{
+			nStableMs = 0;
+			usConnection = usCurrentConnection;
+		}
+
+		if (usChangeStatus & C_PORT_CONNECTION__MASK)
+		{
+			if (pHost->ControlMessage (pEndpoint0,
+				REQUEST_OUT | REQUEST_CLASS | REQUEST_TO_OTHER,
+				CLEAR_FEATURE, C_PORT_CONNECTION, nPortIndex+1, 0, 0) < 0)
+			{
+				CLogger::Get ()->Write (FromHub, LogWarning,
+						      "Cannot clear C_PORT_CONNECTION while "
