new file mode 100644
index 00000000..6e44d6e7
--- /dev/null
+++ b/libs/circle/include/circle/usb/usb8bitdov1.h
@@ -0,0 +1,18 @@
+//
+// usb8bitdov1.h
+//
+// Exact identity helper for the original 8BitDo Wireless Adapter V1.
+//
+#ifndef _circle_usb_usb8bitdov1_h
+#define _circle_usb_usb8bitdov1_h
+
+#include <circle/types.h>
+
+inline boolean IsUSB8BitDoV1Receiver (u16 usVendor, u16 usProduct, u16 usRevision)
+{
+	return   usVendor == 0x045E
+	      && usProduct == 0x028E
+	      && usRevision == 0x0120;
+}
+
+#endif
