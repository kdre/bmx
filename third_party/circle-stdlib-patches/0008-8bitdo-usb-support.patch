+
+CUSBGamePad8BitDoXInputDevice::CUSBGamePad8BitDoXInputDevice (CUSBFunction *pFunction)
+:	CUSBGamePad8BitDoDevice (pFunction)
+{
+}
+
+CUSBGamePad8BitDoXInputDevice::~CUSBGamePad8BitDoXInputDevice (void)
+{
+}
+
+boolean CUSBGamePad8BitDoXInputDevice::StartXInput (void)
+{
+	if (!StartRequest ())
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError,
+				      "XInput interrupt IN queue failed");
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+int CUSBGamePad8BitDoXInputDevice::SendXInputMagicControl (void)
+{
+	// Linux xpad queues the interrupt-IN transfer first, then performs this
+	// vendor request for Xbox 360-compatible third-party controllers. Some
+	// devices stall the request, so callers intentionally treat it as non-fatal.
+	DMA_BUFFER (u8, MagicMessage, 20);
+	int nResult = GetHost ()->ControlMessage (GetEndpoint0 (),
+						 REQUEST_IN | REQUEST_VENDOR | REQUEST_TO_INTERFACE,
+						 0x01, 0x0100, 0x0000,
+						 MagicMessage, 20);
+	CLogger::Get ()->Write (FromUSBPad8BitDo,
+				nResult < 0 ? LogWarning : LogNotice,
+				"XInput magic control request returned %d bytes", nResult);
+
+	return nResult;
+}
+
+boolean CUSBGamePad8BitDoXInputDevice::SetLEDMode (TGamePadLEDMode Mode)
+{
+	static const u8 LEDMode[] = {0x00, 0x06, 0x07, 0x08, 0x09};
+
+	if (Mode >= sizeof LEDMode / sizeof LEDMode[0])
+	{
+		return FALSE;
+	}
+
+	DMA_BUFFER (u8, Command, 3);
+	Command[0] = 0x01;
+	Command[1] = 0x03;
+	Command[2] = LEDMode[Mode];
+
+	return SendToEndpointOut (Command, 3);
+}
+
+boolean CUSBGamePad8BitDoXInputDevice::Configure (void)
+{
+	if (!CUSBGamePad8BitDoDevice::Configure ())
+	{
+		return FALSE;
+	}
+
+	const TUSBDeviceDescriptor *pDeviceDesc = GetDevice ()->GetDeviceDescriptor ();
+	assert (pDeviceDesc != 0);
+	assert (pDeviceDesc->idVendor == 0x2DC8 && pDeviceDesc->idProduct == 0x3106);
+
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+			      "Receiver revision %x", (unsigned) pDeviceDesc->bcdDevice);
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+			      "Interface %u class %02X subclass %02X protocol %02X endpoints %u",
+			      (unsigned) GetInterfaceNumber (),
+			      (unsigned) GetInterfaceClass (),
+			      (unsigned) GetInterfaceSubClass (),
+			      (unsigned) GetInterfaceProtocol (),
+			      (unsigned) GetNumEndpoints ());
+
+	// Match Linux xpad's initial player-identification command for this
+	// receiver. SetLEDMode (GamePadLEDModeOn1) would send 0x06.
+	DMA_BUFFER (u8, InitCommand, 3);
+	InitCommand[0] = 0x01;
+	InitCommand[1] = 0x03;
+	InitCommand[2] = 0x02;
+
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice, "Init OUT begin");
+	if (!SendToEndpointOut (InitCommand, 3))
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError, "Init OUT failed");
+		return FALSE;
+	}
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice, "Init OUT complete");
+
+	if (pDeviceDesc->bcdDevice == 0x0100)
+	{
+		// The receiver first enumerates with bootstrap firmware 1.00,
+		// then disconnects and returns as 3107 (idle) or as the 1.14
+		// runtime device after pairing. Polling the bootstrap input
+		// endpoint produces transaction errors and can interfere with
+		// this mode switch. The initialization command above is all it
+		// needs here. Do not publish this transient personality as a
+		// gamepad while waiting for the runtime device.
+		UnregisterDevice ();
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+				      "Waiting for runtime re-enumeration");
+		return TRUE;
+	}
+
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+			      "Interrupt IN queue begin");
+	if (!StartXInput ())
+	{
+		return FALSE;
+	}
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+			      "Interrupt IN queued");
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+			      "Magic control begin on interface %u",
+			      (unsigned) GetInterfaceNumber ());
+
+	SendXInputMagicControl ();
+
+	return TRUE;
+}
