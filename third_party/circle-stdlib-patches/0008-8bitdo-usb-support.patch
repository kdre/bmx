+#include <circle/usb/usbgamepad.h>
+#include <circle/types.h>
+
+// Shared protocol support for 8BitDo receivers which expose Xbox/XUSB-style
+// input reports with a 0x1400 header. This is not a generic base for 8BitDo
+// HID, Switch-mode or keyboard devices.
+class CUSBGamePad8BitDoDevice : public CUSBGamePadDevice
+{
+public:
