+
+CUSBGamePad8BitDoUM2Device::CUSBGamePad8BitDoUM2Device (CUSBFunction *pFunction)
+:	CUSBGamePad8BitDoDevice (pFunction),
+	m_bInterfaceOK (SelectInterfaceByClass (0xFF, 0x5D, 0x01, 2))
+{
+}
+
+CUSBGamePad8BitDoUM2Device::~CUSBGamePad8BitDoUM2Device (void)
+{
+}
+
+int CUSBGamePad8BitDoUM2Device::SendXInputMagicControl (void)
+{
+	// Linux xpad queues interrupt-IN before issuing this request. The request
+	// is diagnostic/non-fatal because compatible receivers may stall it while
+	// still delivering valid XInput reports.
+	DMA_BUFFER (u8, MagicMessage, 20);
+	int nResult = GetHost ()->ControlMessage (GetEndpoint0 (),
+						 REQUEST_IN | REQUEST_VENDOR | REQUEST_TO_INTERFACE,
+						 0x01, 0x0100, 0x0000,
+						 MagicMessage, 20);
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2,
+				nResult == 20 ? LogNotice : LogWarning,
+				"Magic control request returned %d bytes", nResult);
+
+	return nResult;
+}
+
+boolean CUSBGamePad8BitDoUM2Device::Configure (void)
+{
+	if (!m_bInterfaceOK)
+	{
+		ConfigurationError (FromUSBPad8BitDoUM2);
+		return FALSE;
+	}
+
+	if (!CUSBGamePad8BitDoDevice::Configure ())
+	{
+		return FALSE;
+	}
+
+	const TUSBDeviceDescriptor *pDeviceDesc = GetDevice ()->GetDeviceDescriptor ();
+	assert (pDeviceDesc != 0);
+	assert (pDeviceDesc->idVendor == 0x2DC8 && pDeviceDesc->idProduct == 0x310B);
+
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice,
+			      "UM2 receiver revision %x", (unsigned) pDeviceDesc->bcdDevice);
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice,
+			      "Interface %u class %02X subclass %02X protocol %02X endpoints %u",
+			      (unsigned) GetInterfaceNumber (),
+			      (unsigned) GetInterfaceClass (),
+			      (unsigned) GetInterfaceSubClass (),
+			      (unsigned) GetInterfaceProtocol (),
+			      (unsigned) GetNumEndpoints ());
+
+	DMA_BUFFER (u8, InitCommand, 3);
+	InitCommand[0] = 0x01;
+	InitCommand[1] = 0x03;
+	InitCommand[2] = 0x02;
+
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice, "Init OUT begin");
+	if (!SendToEndpointOut (InitCommand, 3))
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogError, "Init OUT failed");
+		return FALSE;
+	}
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice, "Init OUT complete");
+
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice, "Interrupt IN queue begin");
+	if (!StartRequest ())
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogError,
+				      "XInput interrupt IN queue failed");
+		return FALSE;
+	}
+	CLogger::Get ()->Write (FromUSBPad8BitDoUM2, LogNotice, "Interrupt IN queued");
+
+	SendXInputMagicControl ();
+
+	return TRUE;
+}
